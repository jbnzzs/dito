# Exemplo de configuracao LOCAL - NAO adicionar senhas reais ao Git.
# Render: preencher as variaveis em Environment, sem enviar o .env.
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE
DEBUG=True
DATABASE_URL=postgresql://usuario:senha@localhost:5432/dito_dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DITO_EMAIL_CONSOLE=1
# Definido somente se quiser executar migrations no build (com backup):
# RUN_MIGRATIONS_ON_BUILD=1
